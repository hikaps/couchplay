{
    "app-id": "io.github.hikaps.couchplay",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "couchplay",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=all",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.kde.KWin",
        "--talk-name=org.kde.kglobalaccel",
        "--talk-name=org.freedesktop.Flatpak",
        "--own-name=com.github.CouchPlay",
        "--system-talk-name=org.freedesktop.login1",
        "--filesystem=~/.local/share/applications:rw",
        "--filesystem=~/.local/share/Steam:ro",
        "--filesystem=~/.local/share/Steam/userdata:rw",
        "--filesystem=~/.steam:ro",
        "--filesystem=~/.steam/steam:ro",
        "--filesystem=~/.steam/steam/userdata:rw",
        "--filesystem=~/.var/app/com.valvesoftware.Steam/data/Steam:ro",
        "--filesystem=~/.var/app/com.valvesoftware.Steam/data/Steam/userdata:rw",
        "--filesystem=~/.var/app/com.valvesoftware.Steam/.local/share/Steam:ro",
        "--filesystem=~/.var/app/com.valvesoftware.Steam/.local/share/Steam/userdata:rw",
        "--filesystem=~/.var/app/com.valvesoftware.Steam/.steam/steam:ro",
        "--filesystem=~/.var/app/com.valvesoftware.Steam/.steam/steam/userdata:rw",
        "--filesystem=~/.var/app/com.heroicgameslauncher.hgl/config/heroic:ro",
        "--filesystem=~/.config/heroic:ro",
        "--filesystem=~/.config/legendary:ro",
        "--filesystem=~/Games/Heroic:ro"
    ],
    "modules": [
        {
            "name": "couchplay",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/hikaps/couchplay.git",
                    "branch": "main"
                }
            ],
            "post-install": [
                "install -Dm755 ${FLATPAK_DEST}/lib/libexec/couchplay-vdisplay ${FLATPAK_DEST}/libexec/couchplay-vdisplay",
                "install -Dm755 ${FLATPAK_DEST}/lib/libexec/couchplay-padfwd ${FLATPAK_DEST}/libexec/couchplay-padfwd",
                "install -Dm644 data/io.github.hikaps.couchplay.desktop ${FLATPAK_DEST}/share/applications/io.github.hikaps.couchplay.desktop",
                "install -Dm644 data/io.github.hikaps.couchplay.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.hikaps.couchplay.metainfo.xml",
                "install -Dm644 data/icons/io.github.hikaps.couchplay.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/io.github.hikaps.couchplay.png"
            ],
            "cleanup": [
                "/lib/pkgconfig",
                "/include",
                "*.a",
                "*.la"
            ]
        }
    ]
}
